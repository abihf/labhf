# SPDX-License-Identifier: GPL-3.0-or-later
# Seal the chunked image (second half of `make build`, see Containerfile):
# sign systemd-boot (its own layer), compute the composefs digest over
# exactly the layers that ship, build and sign the UKI, add it as the last
# layer. The digest must be computed after
# chunking: chunkah may change mtimes, and mtimes are part of the composefs
# metadata.
ARG FEDORA=45
ARG BASE=quay.io/fedora/fedora-bootc:${FEDORA}
ARG CHUNKED=localhost/labhf-chunked:build

FROM ${CHUNKED} AS chunked

FROM ${BASE} AS signer
RUN --mount=type=cache,id=labhf-dnf,target=/var/cache/libdnf5,sharing=locked \
    dnf -y --setopt=keepcache=True install systemd-ukify sbsigntools

# systemd-boot from the systemd-boot-unsigned package, signed. Its own layer:
# the signature carries a signing time, so these bytes are new every build.
FROM signer AS sdboot-sign
ARG SB_CERT_SHA256
RUN --network=none \
    --mount=type=bind,from=chunked,source=/usr/lib/systemd/boot/efi,target=/in \
    --mount=type=secret,id=sb_key \
    --mount=type=secret,id=sb_cert \
    test "$(sha256sum < /run/secrets/sb_cert | cut -c1-64)" = "$SB_CERT_SHA256" && \
    mkdir -p /out && \
    /usr/lib/systemd/systemd-sbsign sign \
        --private-key /run/secrets/sb_key \
        --certificate /run/secrets/sb_cert \
        --output /out/systemd-bootx64.efi.signed \
        /in/systemd-bootx64.efi && \
    cp /out/systemd-bootx64.efi.signed /out/systemd-bootx64.efi

FROM chunked AS signed
COPY --from=sdboot-sign /out/ /usr/lib/systemd/boot/efi/

FROM signer AS sealer
ARG SB_CERT_SHA256
RUN --network=none \
    --mount=type=bind,from=signed,target=/target \
    --mount=type=bind,source=build,target=/ctx/build \
    --mount=type=secret,id=sb_key \
    --mount=type=secret,id=sb_cert \
    --mount=type=tmpfs,target=/tmp \
    test "$(sha256sum < /run/secrets/sb_cert | cut -c1-64)" = "$SB_CERT_SHA256" && \
    /ctx/build/seal-uki.sh

FROM signed
COPY --from=sealer /out/boot /boot
LABEL containers.bootc=1
LABEL org.opencontainers.image.title="labhf"
LABEL org.opencontainers.image.description="Sealed Fedora bootc homelab image: k3s, NVIDIA, mdadm, cage+WPE kiosk"
ENV container=oci
STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
