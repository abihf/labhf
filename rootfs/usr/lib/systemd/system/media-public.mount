# Fast public data: NVMe partition "public" (unencrypted), see repart.d/40-public.conf.
# context=container_file_t: k3s pods (SELinux enforcing) use it via hostPath.
[Unit]
Description=Fast public data (NVMe)
Before=k3s.service
# not Required by k3s: if it is missing, /media/public is an empty directory on
# the read-only root and writes fail (EROFS) instead of landing elsewhere

[Mount]
What=/dev/disk/by-partlabel/public
Where=/media/public
Type=ext4
Options=nodev,nosuid,noatime,discard,context=system_u:object_r:container_file_t:s0

[Install]
WantedBy=local-fs.target
