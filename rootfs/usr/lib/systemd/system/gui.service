[Unit]
Description=Auto-login gui session: cage + WPE MiniBrowser on tty1
After=systemd-user-sessions.service plymouth-quit-wait.service network-online.target
Wants=network-online.target
# Fedora's VT console is kmscon (autovt@ -> kmsconvt@); it holds DRM master
# on tty1, and cage then fails with "Could not take device: busy".
Conflicts=getty@tty1.service kmsconvt@tty1.service autovt@tty1.service
After=getty@tty1.service kmsconvt@tty1.service autovt@tty1.service

[Service]
Type=simple
User=gui
WorkingDirectory=~
PAMName=cage
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
Environment=XDG_SESSION_TYPE=wayland
# GUI_URL, GUI_GPU, GUI_OUTPUT, GUI_TRANSFORM: see /usr/bin/labhf-gui
EnvironmentFile=-/etc/labhf/gui.env
ExecStart=/usr/bin/labhf-gui
Restart=always
RestartSec=5

# Hardening. Not PrivateDevices (DRM, input, tty) and not RestrictNamespaces
# or a syscall filter: WebKit's bwrap sandbox needs user namespaces.
# Not ProtectKernelTunables, ProtectKernelLogs or ProtectHostname either: each
# bind-mounts over part of /proc, and the kernel then refuses bwrap's new proc
# mount ("Can't mount proc on /proc: Operation not permitted").
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=-/run/user/2000 -/var/home/gui
PrivateTmp=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=multi-user.target
