#!/usr/bin/bash
# SPDX-License-Identifier: GPL-3.0-or-later
# TPM rollback lock for the LUKS state volume (systemd-pcrlock on PCR 4).
#
# Secure Boot accepts every UKI ever signed with the db key, so PCR 7 alone
# would unseal `state` for an old, vulnerable release copied onto the ESP and
# the plain root. PCR 4 holds the Authenticode hashes of systemd-boot and of
# the UKI that booted; the pcrlock policy (a TPM NV index, enrolled by
# labhf-enroll-tpm next to the literal PCR 0,2,3,5,7 + 15=0 policy) allows only
# the UKIs of the deployments bootc has: booted, staged, rollback.
#
# The ESP is writable offline, so its files are recorded only from the
# running system, and never just because they booted:
#   enroll    boot loader + every current deployment's UKI (labhf-enroll-tpm)
#   boot      drop UKIs whose deployment bootc no longer has (service start)
#   shutdown  add the staged deployment's UKI, which `bootc upgrade` wrote
#             to the ESP (service stop, before bootc finalizes the entries)
#   status    recorded UKIs vs. deployments
#
# The records (.pcrlock files) and the policy (with the NV index's sealed PIN)
# live in /var/lib, on the encrypted state volume. systemd-pcrlock also puts
# the public part on the ESP (loader/credentials/pcrlock.*.cred) for the initrd.
set -euo pipefail

PL=/usr/lib/systemd/systemd-pcrlock
DIR=/var/lib/labhf/pcrlock.d
LOADER=$DIR/610-labhf-boot-loader.pcrlock.d
UKIS=$DIR/650-labhf-uki.pcrlock.d
POLICY=/var/lib/systemd/pcrlock.json

say() { echo "labhf-pcrlock: $*" >&2; }
die() { say "$*"; exit 1; }

# booted, staged, rollback (whichever exist)
deployments() {
    bootc status --format=json |
        jq -r '.status | (.booted, .staged, .rollback) | select(. != null) | .composefs.verity // empty'
}
staged() { bootc status --format=json | jq -r '.status.staged.composefs.verity // empty'; }
booted() { bootc status --format=json | jq -r '.status.booted.composefs.verity // empty'; }

esp() { bootctl --print-esp-path; }
uki_of() {
    local f
    f="$(esp)/EFI/Linux/bootc/bootc_composefs-$1.efi"
    [[ -f $f ]] || die "no UKI on the ESP for deployment ${1:0:16}…: $f"
    echo "$f"
}

lock_uki() {
    mkdir -p "$UKIS"
    "$PL" lock-uki --pcrlock="$UKIS/$1.pcrlock" "$(uki_of "$1")"
    say "recorded UKI ${1:0:16}…"
}

# remove records of deployments bootc no longer has
prune() {
    local f v known
    known=$(deployments)
    for f in "$UKIS"/*.pcrlock; do
        [[ -e $f ]] || continue
        v=$(basename "$f" .pcrlock)
        grep -qxF "$v" <<<"$known" || { rm -f "$f"; say "dropped UKI ${v:0:16}…"; }
    done
}

# systemd's components, optionally without 350-action-efi-application:
# QEMU's firmware measures "Calling EFI Application from Boot Option" into
# PCR 4, the real PC's (AMD) doesn't. Allowing both would double the values
# (a TPM policy takes at most 8 per PCR), so the firmware's own event log
# decides: make_policy retries without it only when the log lacks it.
STOCK=/run/labhf-pcrlock.d
ACTION=350-action-efi-application
stock_components() {  # [skip-component]
    local f
    rm -rf "$STOCK"
    mkdir -p "$STOCK"
    for f in /usr/lib/pcrlock.d/*; do
        [[ -n ${1:-} && ${f##*/} == "$1".pcrlock* ]] || ln -s "$f" "$STOCK/"
    done
}

# PCR 4 only; the other PCRs stay a literal policy in the LUKS token.
# --strict: without it, a boot that matches no record silently drops PCR 4
# and writes an empty (always-unsealing) policy. --location=749: stop before
# the os-separator (750), which this initrd doesn't measure before unlocking.
make_policy() {
    local out rc=0 skip=
    for skip in "" "$ACTION"; do
        stock_components "$skip"
        rc=0
        out=$("$PL" make-policy --strict=yes --pcr=4 --location=749 \
            --components="$STOCK" --components="$DIR" \
            --policy="$POLICY" 2>&1) || rc=$?
        # retry only if this firmware doesn't measure the action at all
        (( rc != 0 )) && [[ -z $skip ]] &&
            grep -qF "Couldn't find component '$ACTION' in event log" <<<"$out" || break
    done
    # expected: records of PCRs outside the policy match nothing, and
    # components after this boot's current point aren't in the log yet
    grep -vE "^Event log record [0-9]+ \(PCR ([0-35-9]|1[0-9]|2[0-3]),|^Didn't find component|^Skipped [0-9]+ components" \
        <<<"$out" >&2 || true
    (( rc == 0 )) || say "make-policy failed (exit $rc); the TPM policy is unchanged"
    return "$rc"
}

recorded() { [[ -f $UKIS/$1.pcrlock ]]; }

exec 9>/run/labhf-pcrlock.lock
flock 9

case ${1:-} in
enroll)
    rm -rf "$LOADER" "$UKIS"
    mkdir -p "$LOADER" "$UKIS"
    chmod 0700 /var/lib/labhf "$DIR"
    e=$(esp)
    for f in "$e/EFI/BOOT/BOOTX64.EFI" "$e/EFI/systemd/systemd-bootx64.efi"; do
        [[ -f $f ]] || continue
        n=$(basename "${f,,}" .efi)
        "$PL" lock-pe --pcrlock="$LOADER/$n.pcrlock" "$f"
        say "recorded boot loader $f"
    done
    while read -r v; do lock_uki "$v"; done < <(deployments)
    make_policy
    ;;
boot)
    [[ -f $POLICY ]] || { say "no pcrlock policy (labhf-enroll-tpm not run)"; exit 0; }
    b=$(booted)
    recorded "$b" || say "WARNING: the booted UKI (${b:0:16}…) is not in the TPM policy, so state was unlocked with the passphrase. If this deployment is yours, run labhf-enroll-tpm; if not, the ESP was tampered with."
    prune
    make_policy
    ;;
shutdown)
    [[ -f $POLICY ]] || exit 0
    s=$(staged)
    [[ -n $s ]] || exit 0
    lock_uki "$s"
    make_policy || die "staged deployment ${s:0:16}… is NOT in the TPM policy: the next boot will ask for the LUKS passphrase"
    ;;
status)
    b=$(booted) s=$(staged) known=$(deployments)
    while read -r v; do
        role=rollback; [[ $v == "$b" ]] && role=booted; [[ $v == "$s" ]] && role=staged
        if recorded "$v"; then st=recorded; else st=MISSING; fi
        printf '%-8s %-8s %s…\n' "$st" "$role" "${v:0:32}"
    done <<<"$known"
    for f in "$UKIS"/*.pcrlock; do
        [[ -e $f ]] || continue
        v=$(basename "$f" .pcrlock)
        grep -qxF "$v" <<<"$known" || printf '%-8s %-8s %s…\n' stale - "${v:0:32}"
    done
    [[ -f $POLICY ]] && jq -r '"policy: NV index \(.nvIndex), PCR \(.pcrValues[].pcr): \(.pcrValues[].values | length) values"' "$POLICY" ||
        echo "policy: none"
    # next boot: a staged deployment (bootc makes it the default at
    # shutdown; its entry isn't on the ESP before that), else systemd-boot's
    # default entry as bootctl resolves it (one-shot, default, loader.conf)
    if [[ -n $s ]]; then
        n=$s how=staged
    else
        n=$(bootctl list --json=short 2>/dev/null |
            jq -r '.[] | select(.isDefault) | .uki // empty' |
            sed -n 's/.*bootc_composefs-\([0-9a-f]*\)\.efi$/\1/p')
        how="default entry"
    fi
    if [[ -z $n ]]; then
        echo "next boot: not a bootc UKI (bootctl list): no TPM unlock"
    elif [[ ! -f $POLICY ]]; then
        echo "next boot: $how ${n:0:16}…, no rollback lock (any db-signed UKI unlocks)"
    elif recorded "$n"; then
        echo "next boot: $how ${n:0:16}…, in the rollback lock: TPM unlock"
    elif [[ -n $s ]] && systemctl -q is-active labhf-pcrlock.service; then
        echo "next boot: $how ${n:0:16}…, recorded at shutdown (labhf-pcrlock.service): TPM unlock"
    else
        echo "next boot: $how ${n:0:16}…, NOT in the rollback lock: LUKS passphrase"
        [[ -n $s ]] && echo "  labhf-pcrlock.service is not active, so shutdown won't record it; run: systemctl start labhf-pcrlock.service"
    fi
    ;;
*)
    echo "usage: labhf-pcrlock enroll|boot|shutdown|status" >&2
    exit 2
    ;;
esac
